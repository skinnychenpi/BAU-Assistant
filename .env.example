# ── SMART Platform ────────────────────────────────────────────────────────────
SMART_API_URL=https://smart.shopee.io/apis/smart/v1/orchestrator/deployments/invoke
SMART_HASH_ID=your-hash-id
SMART_ENDPOINT_KEY=your-endpoint-key
SMART_USER_ID=bau-assistant
# Max tool-call round-trips (SMART agent can request up to this many tools)
AGENT_MAX_STEPS=3

# ── Anthropic (legacy — kept for reference) ──────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Gmail ──────────────────────────────────────────────────────────────────────
# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json
# Path where the token will be cached after first auth
GMAIL_TOKEN_PATH=./credentials/gmail_token.json
# Label/subject filter to find Airflow alert emails
GMAIL_SEARCH_QUERY=subject:"Airflow" after:2d

# ── Google Sheets (historical issues) ─────────────────────────────────────────
GSHEET_CREDENTIALS_PATH=./credentials/gmail_credentials.json
GSHEET_SPREADSHEET_ID=your-spreadsheet-id
GSHEET_SHEET_NAME=Sheet1

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_BASE_URL=http://your-airflow-host:8080
AIRFLOW_USERNAME=your_username
AIRFLOW_PASSWORD=your_password

# ── YARN (pending infra team confirmation) ────────────────────────────────────
YARN_RESOURCEMANAGER_URL=http://your-yarn-rm-host:8088

# ── GitLab ─────────────────────────────────────────────────────────────────────
GITLAB_BASE_URL=http://your-gitlab-host
GITLAB_TOKEN=glpat-...
# Default project/group where DAG code lives
GITLAB_DEFAULT_PROJECT=data/pipelines

# ── Confluence ─────────────────────────────────────────────────────────────────
CONFLUENCE_BASE_URL=https://your-confluence-host
CONFLUENCE_USERNAME=your_username
CONFLUENCE_TOKEN=your-api-token

# ── Internal APIs (currently mocked) ──────────────────────────────────────────
INTERNAL_REPORT_API_URL=http://mock/api/reports
INTERNAL_REPORT_API_TOKEN=mock-token
INTERNAL_MSG_API_URL=http://mock/api/messages
INTERNAL_MSG_API_TOKEN=mock-token

# ── Agent behaviour ────────────────────────────────────────────────────────────
# How many times longer than average before a run is flagged as overtime
OVERTIME_THRESHOLD=1.5

# ── DAG monitoring ────────────────────────────────────────────────────────────
# Path to text file listing DAG IDs to monitor (one per line)
DAG_LIST_PATH=./config/dag_list.txt
